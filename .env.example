# Local (Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bts8
POSTGRES_PASSWORD=bts8
POSTGRES_DB=bts8

# Heroku Postgres (definido automaticamente pelo addon)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true  # opcional; auto-detectado em hosts amazonaws.com

API_PORT=3000
# Heroku define PORT automaticamente
APP_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
DB_MIGRATIONS_RUN=true

# Primeiro administrador da plataforma (criado automaticamente se não existir)
PLATFORM_ADMIN_EMAIL=admin@bts8.app
PLATFORM_ADMIN_PASSWORD=changeme
PLATFORM_ADMIN_NAME=Administrador

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bts8
